{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node", "react", "jsx-a11y", "vitest"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "settings": {
    "react": {
      "version": "19.0.0"
    }
  },
  "rules": {
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "no-console": "error",
    "no-sequences": "error",
    "no-useless-return": "error",
    "no-promise-executor-return": "error",
    "no-unused-vars": "error",
    "radix": "error",
    "require-await": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "promise/catch-or-return": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/no-useless-undefined": "error",
    "unicorn/prefer-node-protocol": "error",
    "react/react-in-jsx-scope": "off",
    "react/no-unknown-property": "off",
    "react/jsx-key": "error",
    "react/no-danger": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css",
          "@pomkuiz/design-system/load-design-system",
          "@fontsource-variable/**",
          "katex/contrib/**"
        ]
      }
    ],
    "react/immutability": "off",
    "oxc/no-async-endpoint-handlers": "off",
    "oxc/no-map-spread": "off",
    "no-await-in-loop": "off"
  },
  "overrides": [
    {
      "files": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "require-await": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["apps/backoffice/server/shared/text-cleaning.ts"],
      "rules": {
        "no-control-regex": "off"
      }
    }
  ],
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/workspace/**", "**/coverage/**"]
}
